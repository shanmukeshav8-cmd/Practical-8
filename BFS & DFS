if __name__ == "__main__":
    g = Graph()
    
    # Constructing a sample graph:
    #     A --- B --- D
    #     |     |
    #     C --- E
    g.add_edge('A', 'B')
    g.add_edge('A', 'C')
    g.add_edge('B', 'D')
    g.add_edge('B', 'E')
    g.add_edge('C', 'E')

    print("Graph Structure (Adjacency List):", g.adj_list)
    print("BFS Order (starting from A):", g.bfs('A'))
    print("DFS Order (starting from A):", g.dfs('A'))



